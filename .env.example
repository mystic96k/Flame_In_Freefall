# Copia este archivo como .env y llena SOLO lo que vayas a usar.
# Nunca subas tu .env a GitHub. En Render / Hugging Face estas variables se ponen como "secrets".

# ---- Proveedor de IA ----
# "openai_compatible" (Groq, Ollama, OpenAI...) | "anthropic" | "none" (respuestas automáticas sin IA)
LLM_PROVIDER=openai_compatible

# Groq (gratis): crea tu llave en https://console.groq.com/keys
# Lista de modelos vigentes: https://console.groq.com/docs/models
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=llama-3.3-70b-versatile

# Ollama local (sin internet, en tu laptop): ollama pull llama3.1 y luego:
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=llama3.1

# Anthropic (Claude), opcional
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ---- Datos ----
# true = usa el dataset de demostración si no hay datos reales procesados
ALLOW_DEMO_DATA=true
